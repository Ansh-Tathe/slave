# =============================================================================
# ibvap/.env.example
# Copy to .env and fill in real values. Never commit .env to git.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ibvap
POSTGRES_USER=ibvap
POSTGRES_PASSWORD=ibvap_dev_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── MinIO / object storage ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=ibvap_admin
MINIO_ROOT_PASSWORD=ibvap_minio_secret
MINIO_BUCKET_CLIPS=ibvap-clips
MINIO_BUCKET_SNAPSHOTS=ibvap-snapshots
MINIO_SECURE=false

# ── API / auth ────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_random_64_char_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── External C2 webhook ───────────────────────────────────────────────────────
C2_API_KEY=

# ── Model paths (overrides defaults inside services/) ─────────────────────────
YOLO_MODEL_PATH=models/yolov8n.pt
FACE_MODEL_PATH=models/det_10g.onnx
ANPR_PLATE_MODEL_PATH=models/plate_detector.pt
ANPR_OCR_MODEL_PATH=models/paddleocr/

# ── Inference settings ────────────────────────────────────────────────────────
DEVICE=cuda:0        # cuda:0 | cpu
HALF=true            # FP16 inference
BATCH_SIZE=1         # frames per inference call (increase for multi-cam batching)
